<Window x:Class="TD_KT.StartupSplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Đang khởi động"
        Width="720"
        Height="430"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        Background="Transparent"
        AllowsTransparency="True">
    <Border Background="White" CornerRadius="4" BorderBrush="#D8DCE5" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="22" ShadowDepth="0" Opacity="0.25"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="265"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#1672D4" CornerRadius="4,4,0,0">
                <Grid>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Image Source="/Images/logo.ico" Width="62" Height="62" Margin="0,0,0,14"/>
                        <TextBlock x:Name="txtApplicationName"
                                   Text="PHẦN MỀM THI ĐUA - KHEN THƯỞNG"
                                   Foreground="White"
                                   FontSize="27"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"/>
                        <TextBlock x:Name="txtVersion"
                                   Text="Phiên bản 1.0.0.0"
                                   Foreground="#E7F2FF"
                                   FontSize="17"
                                   HorizontalAlignment="Center"
                                   Margin="0,12,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="52,28,52,22">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock x:Name="txtStatus"
                           Grid.Row="0"
                           Text="Đang khởi động..."
                           Foreground="#4B5563"
                           FontSize="15"
                           Margin="0,0,0,10"/>

                <ProgressBar Grid.Row="1"
                             Height="13"
                             IsIndeterminate="True"
                             Foreground="#1672D4"
                             Background="#D9DEE8"
                             BorderThickness="0"/>

                <Grid Grid.Row="2" VerticalAlignment="Bottom">
                    <TextBlock Text="Trung tâm TSKT 47 - Bộ Tham mưu - Quân chủng Hải quân"
                               Foreground="#7B8492"
                               FontSize="12"
                               VerticalAlignment="Bottom"/>
                    <TextBlock Text="TD-KT"
                               Foreground="#1672D4"
                               FontSize="20"
                               FontWeight="Bold"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Bottom"/>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
