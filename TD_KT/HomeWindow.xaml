<Window
    x:Class="TD_KT.HomeWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Hệ thống thi đua khen thưởng"
    WindowStartupLocation="CenterScreen"
    ResizeMode="CanResize"
    MinWidth="1024"
    MinHeight="600"
    WindowState="Maximized"
    WindowStyle="None"
    AllowsTransparency="True"
    Background="Transparent">

    <Window.Resources>
        <!-- Menu Button Style - Collapsed (chỉ icon) -->
        <Style x:Key="MenuButtonStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#E54646"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="5,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border" 
                                Background="Transparent" 
                                CornerRadius="12"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E54646"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#B0E0E6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Window Control Button -->
        <Style x:Key="WindowControlButton" TargetType="Button">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#E54646"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FCDAD5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Window Close Button -->
        <Style x:Key="WindowCloseButton" TargetType="Button">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#E54646"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E54646"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#FCDAD5" CornerRadius="20" Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.3" Color="#E54646"/>
        </Border.Effect>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- SIDEBAR - Thu/Mở -->
            <Border x:Name="SidebarBorder"
                    Grid.Column="0" 
                    Background="Transparent" 
                    CornerRadius="20,0,0,20"
                    Padding="10,25,10,20"
                    Width="80"
                    MouseEnter="Sidebar_MouseEnter"
                    MouseLeave="Sidebar_MouseLeave">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Logo/Title area -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,20" HorizontalAlignment="Center">
                        <Image Source="/Images/cotoquoc.png" 
                               Width="50" Height="50"
                               Margin="0,0,0,8"
                               HorizontalAlignment="Center"/>
                        <TextBlock x:Name="txtTitle"
                                   Text="TRUNG TÂM 47"
                                   Foreground="#E54646"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   Visibility="Collapsed"/>
                        <TextBlock x:Name="txtSubtitle"
                                   Text="Thi đua Khen thưởng"
                                   Foreground="#E54646"
                                   FontSize="10"
                                   Opacity="0.7"
                                   HorizontalAlignment="Center"
                                   Visibility="Collapsed"/>
                    </StackPanel>

                    <!-- Menu -->
                    <StackPanel Grid.Row="1" VerticalAlignment="Top">
                        <RadioButton x:Name="btnHome"
                                     Style="{StaticResource MenuButtonStyle}"
                                     IsChecked="True"
                                     Click="btnHome_Click"
                                     ToolTip="Trang chủ">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="/Images/home-page.png" Width="28" Height="28" VerticalAlignment="Center"/>
                                <TextBlock x:Name="txtMenu0" Text="Trang chủ" VerticalAlignment="Center" FontWeight="SemiBold" Margin="12,0,0,0" Visibility="Collapsed"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="btnWeekly"
                                     Style="{StaticResource MenuButtonStyle}"
                                     Click="btnWeekly_Click"
                                     ToolTip="Chấm điểm thi đua">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="/Images/write.png" Width="28" Height="28" VerticalAlignment="Center"/>
                                <TextBlock x:Name="txtMenu1" Text="Chấm điểm thi đua" VerticalAlignment="Center" FontWeight="SemiBold" Margin="12,0,0,0" Visibility="Collapsed"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="btnDocumentProposal"
                                     Style="{StaticResource MenuButtonStyle}"
                                     Click="btnDocumentProposal_Click"
                                     ToolTip="Văn bản đề nghị">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="/Images/vanban.png" Width="28" Height="28" VerticalAlignment="Center"/>
                                <TextBlock x:Name="txtMenu2" Text="Văn bản, Hồ sơ khen thưởng" VerticalAlignment="Center" FontWeight="SemiBold" Margin="12,0,0,0" Visibility="Collapsed"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="btnDecision"
                                     Style="{StaticResource MenuButtonStyle}"
                                     Click="btnDecision_Click"
                                     ToolTip="Quyết định khen thưởng">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="/Images/quyetdinh.png" Width="28" Height="28" VerticalAlignment="Center"/>
                                <TextBlock x:Name="txtMenu3" Text="Quyết định khen thưởng" VerticalAlignment="Center" FontWeight="SemiBold" Margin="12,0,0,0" Visibility="Collapsed"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="btnReportStatistic"
                                     Style="{StaticResource MenuButtonStyle}"
                                     Click="btnReportStatistic_Click"
                                     ToolTip="Báo cáo - Thống kê">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="/Images/statistics.png" Width="28" Height="28" VerticalAlignment="Center"/>
                                <TextBlock x:Name="txtMenu4" Text="Báo cáo - Thống kê" VerticalAlignment="Center" FontWeight="SemiBold" Margin="12,0,0,0" Visibility="Collapsed"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="btnAdmin"
                                     Style="{StaticResource MenuButtonStyle}"
                                     Click="btnAdmin_Click"
                                     ToolTip="Quản trị hệ thống">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="/Images/administrator.png" Width="28" Height="28" VerticalAlignment="Center"/>
                                <TextBlock x:Name="txtMenu5" Text="Quản trị hệ thống" VerticalAlignment="Center" FontWeight="SemiBold" Margin="12,0,0,0" Visibility="Collapsed"/>
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>

                    <!-- Logout -->
                    <Button Grid.Row="2"
                            x:Name="btnLogout"
                            Click="btnLogout_Click"
                            Background="#FCDAD5"
                            BorderThickness="0"
                            Cursor="Hand"
                            Padding="12"
                            ToolTip="Đăng xuất"
                            HorizontalAlignment="Stretch">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border" 
                                        Background="{TemplateBinding Background}" 
                                        CornerRadius="12"
                                        Padding="{TemplateBinding Padding}">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Image Source="/Images/logout.png" Width="28" Height="28" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="txtLogout" 
                                                   Text="Đăng xuất" 
                                                   Foreground="#E54646" 
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   Margin="10,0,0,0"
                                                   Visibility="Collapsed"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="#FFA07A"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <!-- CONTENT AREA -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="60"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Title Bar -->
                <Border Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid Margin="25,0">
                        <TextBlock x:Name="txtPageTitle"
                                   Text="Trang chủ"
                                   Foreground="#E54646"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Left"/>

                        <!-- Window Controls -->
                        <StackPanel Orientation="Horizontal" 
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center">
                            <Button Content="─" 
                                    Style="{StaticResource WindowControlButton}"
                                    Click="BtnMinimize_Click"/>
                            <Button Content="□" 
                                    Style="{StaticResource WindowControlButton}"
                                    Click="BtnMaximize_Click"/>
                            <Button Content="✕" 
                                    Style="{StaticResource WindowCloseButton}"
                                    Click="BtnClose_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Main Content -->
                <Border Grid.Row="1" 
                        Background="White" 
                        CornerRadius="20,0,0,20"
                        Margin="0,0,20,20"
                        Padding="20">
                    <ContentControl x:Name="MainContent"/>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
