<UserControl
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:av="http://schemas.microsoft.com/expression/blend/2008" 
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    mc:Ignorable="av"
    x:Class="TD_KT.Views.ReportStatisticView" 
    av:DesignHeight="800" 
    av:DesignWidth="1200"
    Background="#F8FAFC">

    <UserControl.Resources>
        <!-- ==================== BUTTON STYLES ==================== -->
        <Style x:Key="BtnPrimary" TargetType="{x:Type Button}">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Background" Value="#3B82F6"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2563EB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BtnGray" TargetType="{x:Type Button}">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E2E8F0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BtnSuccess" TargetType="{x:Type Button}">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Background" Value="#10B981"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#059669"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ==================== INPUT STYLES ==================== -->
        <Style TargetType="{x:Type TextBox}">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#1F2937"/>
            <Setter Property="CaretBrush" Value="#1F2937"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TextBox}">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" HorizontalAlignment="Stretch"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#3B82F6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type ComboBox}">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <!-- ==================== DATAGRID STYLES ==================== -->
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#EFF6FF"/>
                    <Setter Property="Foreground" Value="#1E40AF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="White"/>
            <Style.Triggers>
                <Trigger Property="AlternationIndex" Value="1">
                    <Setter Property="Background" Value="#F9FAFB"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F1F5F9"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#EFF6FF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ==================== TAB STYLES ==================== -->
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="10,10,0,0" Padding="{TemplateBinding Padding}" Margin="{TemplateBinding Margin}">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="border" Property="Background" Value="White"/>
                                <Setter Property="Foreground" Value="#3B82F6"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E2E8F0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FormLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.06"/>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 4 Tabs -->
        <TabControl Grid.Row="1">
            <!-- ================= TAB 3: THỐNG KÊ ĐIỂM THI ĐUA ================= -->
            <TabItem Header="📈  Thống kê điểm thi đua">
                <Border Background="White" CornerRadius="0,12,12,12" Padding="20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Bộ lọc -->
                        <Border Grid.Row="0" Background="#F8FAFC" CornerRadius="10" Padding="16" Margin="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Năm" Style="{StaticResource FormLabelStyle}"/>
                                    <ComboBox ItemsSource="{Binding ScoreYearOptions}"
                      DisplayMemberPath="Name"
                      SelectedItem="{Binding SelectedScoreYear}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Tháng" Style="{StaticResource FormLabelStyle}"/>
                                    <ComboBox ItemsSource="{Binding ScoreMonthOptions}"
                      DisplayMemberPath="Name"
                      SelectedItem="{Binding SelectedScoreMonth}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Bottom">
                                    <Button Content="↻ Làm mới" Style="{StaticResource BtnGray}" Margin="0"
                    Command="{Binding RefreshScoreSummaryCommand}"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- 2 bảng: Tháng và Năm -->
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Bảng Thi đua Tháng -->
                            <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                                        <Border Background="#3B82F6" CornerRadius="6" Padding="8,4" Margin="0,0,10,0">
                                            <TextBlock Text="📅" FontSize="12" Foreground="White"/>
                                        </Border>
                                        <TextBlock Text="{Binding MonthHeaderText}"
                           FontWeight="SemiBold"
                           Foreground="#1F2937"
                           FontSize="14"
                           VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <Border Grid.Row="1" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="10" ClipToBounds="True">
                                        <DataGrid ItemsSource="{Binding ScoreMonthRows}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#F3F4F6"
                          RowHeight="44"
                          AlternationCount="2"
                          BorderThickness="0">
                                            <DataGrid.RowStyle>
                                                <Style TargetType="DataGridRow">
                                                    <Setter Property="Background" Value="White"/>
                                                    <Setter Property="Foreground" Value="#111827"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding GroupId}" Value="1">
                                                            <Setter Property="Background" Value="#EED5D2"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding GroupId}" Value="2">
                                                            <Setter Property="Background" Value="#B0E0E6"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding GroupId}" Value="3">
                                                            <Setter Property="Background" Value="#00F5FF"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding GroupId}" Value="4">
                                                            <Setter Property="Background" Value="#90EE90"/>
                                                        </DataTrigger>

                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter Property="Background" Value="#BFDBFE"/>
                                                            <Setter Property="Foreground" Value="#111827"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </DataGrid.RowStyle>
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Cơ quan/Đơn vị" Width="300" Binding="{Binding OrgUnitName}"/>
                                                <DataGridTextColumn Header="Điểm TB tháng" Width="120" Binding="{Binding AverageScoreText}"/>
                                                <DataGridTextColumn Header="Xếp hạng tháng" Width="120" Binding="{Binding Ranking}"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- Bảng Thi đua Năm -->
                            <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                                        <Border Background="#10B981" CornerRadius="6" Padding="8,4" Margin="0,0,10,0">
                                            <TextBlock Text="📆" FontSize="12" Foreground="White"/>
                                        </Border>
                                        <TextBlock Text="{Binding YearHeaderText}"
                           FontWeight="SemiBold"
                           Foreground="#1F2937"
                           FontSize="14"
                           VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <Border Grid.Row="1" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="10" ClipToBounds="True">
                                        <DataGrid ItemsSource="{Binding ScoreYearRows}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#F3F4F6"
                          RowHeight="44"
                          AlternationCount="2"
                          BorderThickness="0">
                                            <DataGrid.RowStyle>
                                                <Style TargetType="DataGridRow">
                                                    <Setter Property="Background" Value="White"/>
                                                    <Setter Property="Foreground" Value="#111827"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding GroupId}" Value="1">
                                                            <Setter Property="Background" Value="#EED5D2"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding GroupId}" Value="2">
                                                            <Setter Property="Background" Value="#B0E0E6"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding GroupId}" Value="3">
                                                            <Setter Property="Background" Value="#00F5FF"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding GroupId}" Value="4">
                                                            <Setter Property="Background" Value="#90EE90"/>
                                                        </DataTrigger>

                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter Property="Background" Value="#BFDBFE"/>
                                                            <Setter Property="Foreground" Value="#111827"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </DataGrid.RowStyle>
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Cơ quan/Đơn vị" Width="300" Binding="{Binding OrgUnitName}"/>
                                                <DataGridTextColumn Header="Điểm TB năm" Width="120" Binding="{Binding AverageScoreText}"/>
                                                <DataGridTextColumn Header="Xếp hạng năm" Width="120" Binding="{Binding Ranking}"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </Border>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>
            </TabItem>


            <!-- ================= TAB 2: BÁO CÁO KHEN THƯỞNG ================= -->
            <TabItem Header="🏆  Tổng hợp khen thưởng">
                <Border Background="White" CornerRadius="0,12,12,12" Padding="20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Bộ lọc -->
                        <Border Grid.Row="0" Background="#F8FAFC" CornerRadius="10" Padding="16" Margin="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="220"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="300"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Năm" Style="{StaticResource FormLabelStyle}"/>
                                    <ComboBox x:Name="cboYear2" ItemsSource="{Binding YearOptions}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedYear}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Cấp khen thưởng" Style="{StaticResource FormLabelStyle}"/>
                                    <ComboBox x:Name="cboRewardLevel2" ItemsSource="{Binding IssuingLevelOptions}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedIssuingLevel}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="Hình thức khen thưởng" Style="{StaticResource FormLabelStyle}"/>
                                    <ComboBox ItemsSource="{Binding RewardFormOptions}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedRewardForm}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="6">
                                    <TextBlock Text="🔍 Tìm kiếm" Style="{StaticResource FormLabelStyle}"/>
                                    <TextBox x:Name="txtSearch2" Width="240" Margin="0,0,12,0"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>

                                <StackPanel Grid.Column="8" Orientation="Horizontal" VerticalAlignment="Bottom">
                                    <Button Content="↻ Làm mới" Style="{StaticResource BtnGray}"
                                Command="{Binding RefreshRewardReportCommand}"/>
                                    <Button Content="📤 Xuất dữ liệu" Style="{StaticResource BtnPrimary}" Margin="0" Command="{Binding ExportRewardReportCommand}"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- DataGrid Báo cáo khen thưởng -->
                        <Border Grid.Row="1" Style="{StaticResource CardStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                                    <Border Background="#F59E0B" CornerRadius="6" Padding="8,4" Margin="0,0,10,0">
                                        <TextBlock Text="📋" FontSize="12" Foreground="White"/>
                                    </Border>
                                    <TextBlock Text="Danh sách khen thưởng"
                                               FontWeight="SemiBold"
                                               Foreground="#1F2937"
                                               FontSize="14"
                                               VerticalAlignment="Center"/>
                                </StackPanel>

                                <Border Grid.Row="1" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="10" ClipToBounds="True">
                                    <DataGrid x:Name="dgRewardReport"
                                              ItemsSource="{Binding RewardReportRows}"
                                              AutoGenerateColumns="False"
                                              IsReadOnly="True"
                                              CanUserAddRows="False"
                                              GridLinesVisibility="Horizontal"
                                              HorizontalGridLinesBrush="#F3F4F6"
                                              RowHeight="44"
                                              AlternationCount="2"
                                              BorderThickness="0"
                                              SelectionMode="Extended">
                                        <DataGrid.Columns>
                                            <DataGridTemplateColumn Header="" Width="40">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                  HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTextColumn Header="STT" Width="50" Binding="{Binding No}"/>
                                            <DataGridTextColumn Header="Cá nhân/Tập thể" Width="180" Binding="{Binding SubjectName}"/>
                                            <DataGridTextColumn Header="HT khen thưởng" Width="180" Binding="{Binding RewardFormName}"/>
                                            <DataGridTextColumn Header="Số QĐ" Width="180" Binding="{Binding DecisionNumber}"/>
                                            <DataGridTextColumn Header="Cấp khen thưởng" Width="180" Binding="{Binding IssuingLevel}"/>
                                            <DataGridTextColumn Header="Ngày ký" Width="100" Binding="{Binding SignedDateText}"/>
                                            <DataGridTextColumn Header="Người ký" Width="200" Binding="{Binding Signer}"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </TabItem>

            <!-- ================= TAB 3: THỐNG KÊ KHEN THƯỞNG QUA CÁC NĂM ================= -->
            <TabItem Header="📅  Thống kê khen thưởng liên tục">
                <Border Background="White" CornerRadius="0,12,12,12" Padding="20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Bộ lọc -->
                        <Border Grid.Row="0" Background="#F8FAFC" CornerRadius="10" Padding="16" Margin="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="260"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Năm" Style="{StaticResource FormLabelStyle}"/>
                                    <ComboBox ItemsSource="{Binding RewardYearsYearOptions}"
                                              DisplayMemberPath="Name"
                                              SelectedItem="{Binding SelectedRewardYearsYear}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="🔍 Tìm kiếm" Style="{StaticResource FormLabelStyle}"/>
                                    <TextBox Text="{Binding RewardYearsSearchText, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Bottom">
                                    <Button Content="↻ Làm mới" Style="{StaticResource BtnGray}" Command="{Binding RefreshRewardYearsCommand}"/>
                                    <Button Content="📤 Xuất dữ liệu" Style="{StaticResource BtnPrimary}" Margin="0" Command="{Binding ExportRewardYearsCommand}"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- DataGrid Thống kê khen thưởng qua các năm -->
                        <Border Grid.Row="1" Style="{StaticResource CardStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                                    <Border Background="#8B5CF6" CornerRadius="6" Padding="8,4" Margin="0,0,10,0">
                                        <TextBlock Text="📊" FontSize="12" Foreground="White"/>
                                    </Border>
                                    <TextBlock Text="Thống kê khen thưởng"
                                               FontWeight="SemiBold"
                                               Foreground="#1F2937"
                                               FontSize="14"
                                               VerticalAlignment="Center"/>
                                </StackPanel>

                                <Border Grid.Row="1" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="10" ClipToBounds="True">
                                    <DataGrid ItemsSource="{Binding RewardYearsRows}"
                                              AutoGenerateColumns="False"
                                              IsReadOnly="True"
                                              CanUserAddRows="False"
                                              GridLinesVisibility="Horizontal"
                                              HorizontalGridLinesBrush="#F3F4F6"
                                              RowHeight="44"
                                              AlternationCount="2"
                                              BorderThickness="0"
                                              SelectionMode="Extended">
                                        <DataGrid.Columns>
                                            <DataGridTemplateColumn Header="" Width="40">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                  HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTextColumn Header="STT" Width="50" Binding="{Binding No}"/>
                                            <DataGridTextColumn Header="Cá nhân/Tập thể" Width="180" Binding="{Binding SubjectName}"/>
                                            <DataGridTextColumn Header="HT khen thưởng" Width="220" Binding="{Binding RewardFormName}"/>
                                            <DataGridTextColumn Header="Liên tiếp" Width="200" Binding="{Binding ConsecutiveText}"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </TabItem>

            <!-- ================= TAB 4: ĐỀ XUẤT DANH HIỆU THEO THÂM NIÊN ================= -->
            <TabItem Header="🎖️  Thống kê huy chương niên hạn">
                <Border Background="White" CornerRadius="0,12,12,12" Padding="20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Bộ lọc + Quy tắc -->
                        <Grid Grid.Row="0" Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Bộ lọc -->
                            <Border Grid.Column="0" Background="#F8FAFC" CornerRadius="10" Padding="16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="220"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="160"/>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" VerticalAlignment="Bottom">
                                        <TextBlock Text="🔍 Tìm kiếm" Style="{StaticResource FormLabelStyle}"/>
                                        <TextBox Text="{Binding SeniorityOrgUnitSearchText, UpdateSourceTrigger=PropertyChanged}"
                                                 Height="50"
                                                 VerticalContentAlignment="Center"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
                                        <TextBlock Text="Đơn vị" Style="{StaticResource FormLabelStyle}"/>
                                        <ComboBox ItemsSource="{Binding SeniorityOrgUnitOptions}"
                                                  SelectedItem="{Binding SelectedSeniorityOrgUnit}"
                                                  Height="50"
                                                  VerticalContentAlignment="Center"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="4" VerticalAlignment="Bottom">
                                        <TextBlock Text="Trạng thái" Style="{StaticResource FormLabelStyle}"/>
                                        <ComboBox ItemsSource="{Binding SeniorityStatusOptions}"
                                                  SelectedItem="{Binding SelectedSeniorityStatus}"
                                                  Height="50"
                                                  VerticalContentAlignment="Center"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="8" Orientation="Horizontal" VerticalAlignment="Bottom">
                                        <Button Content="↻ Làm mới" Style="{StaticResource BtnGray}" Height="50"
                                                Command="{Binding RefreshSeniorityAwardsCommand}"/>
                                        <Button Content="✓ Đánh dấu đã trao" Style="{StaticResource BtnSuccess}"
                                                Command="{Binding MarkSeniorityAsAwardedCommand}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Bảng quy tắc thâm niên -->
                            <Border Grid.Column="2" Background="#FEF3C7" CornerRadius="10" Padding="16">
                                <StackPanel>
                                    <TextBlock Text="📜 Quy tắc thâm niên:" FontWeight="Bold" Foreground="#92400E" Margin="0,0,0,8" FontSize="13"/>
                                    <TextBlock Text="• 10-14 năm: Huy chương CSVV hạng Ba" Foreground="#92400E" FontSize="12"/>
                                    <TextBlock Text="• 15-19 năm: Huy chương CSVV hạng Hai" Foreground="#92400E" FontSize="12"/>
                                    <TextBlock Text="• 20-24 năm: Huy chương CSVV hạng Nhất" Foreground="#92400E" FontSize="12"/>
                                    <TextBlock Text="• ≥25 năm: Huy chương Quân kỳ Quyết thắng" Foreground="#92400E" FontSize="12"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- DataGrid Đề xuất thâm niên -->
                        <Border Grid.Row="1" Style="{StaticResource CardStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                                    <Border Background="#EF4444" CornerRadius="6" Padding="8,4" Margin="0,0,10,0">
                                        <TextBlock Text="🎖️" FontSize="12" Foreground="White"/>
                                    </Border>
                                    <TextBlock Text="Danh sách huy chương niên hạn"
                                               FontWeight="SemiBold"
                                               Foreground="#1F2937"
                                               FontSize="14"
                                               VerticalAlignment="Center"/>
                                </StackPanel>

                                <Border Grid.Row="1" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="10" ClipToBounds="True">
                                    <DataGrid ItemsSource="{Binding SeniorityAwardRows}"
                                              AutoGenerateColumns="False"
                                              IsReadOnly="True"
                                              CanUserAddRows="False"
                                              GridLinesVisibility="Horizontal"
                                              HorizontalGridLinesBrush="#F3F4F6"
                                              RowHeight="44"
                                              AlternationCount="2"
                                              BorderThickness="0"
                                              SelectionMode="Extended">
                                        <DataGrid.Columns>
                                            <DataGridTemplateColumn Header="" Width="40">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                  HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTextColumn Header="STT" Width="50" Binding="{Binding No}"/>
                                            <DataGridTextColumn Header="Họ và tên" Width="160" Binding="{Binding FullName}"/>
                                            <DataGridTextColumn Header="Cấp bậc" Width="90" Binding="{Binding Rank}"/>
                                            <DataGridTextColumn Header="Chức vụ/Đơn vị" Width="300" Binding="{Binding PositionOrgUnit}"/>
                                            <DataGridTextColumn Header="Ngày nhập ngũ" Width="110" Binding="{Binding EnlistmentDateText}"/>
                                            <DataGridTextColumn Header="Năm phục vụ" Width="180" Binding="{Binding YearsOfServiceText}"/>
                                            <DataGridTextColumn Header="Huy chương niên hạn" Width="250" Binding="{Binding SuggestedReward}"/>
                                            <DataGridTextColumn Header="Trạng thái" Width="100" Binding="{Binding Status}"/>
                                            <DataGridTextColumn Header="Ghi chú" Width="200" Binding="{Binding Note}"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </TabItem>

            <!-- ================= TAB 5: BÁO CÁO DANH HIỆU VỀ HƯU ================= -->
            <TabItem Header="🏅  Theo dõi khen thưởng cống hiến">
                <Border Background="White" CornerRadius="0,12,12,12" Padding="20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1250"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="2*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Bảng dữ liệu -->
                        <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                                    <Border Background="#0EA5E9" CornerRadius="6" Padding="8,4" Margin="0,0,10,0">
                                        <TextBlock Text="🏅" FontSize="12" Foreground="White"/>
                                    </Border>
                                    <TextBlock Text="Danh sách khen thưởng"
                                               FontWeight="SemiBold"
                                               Foreground="#1F2937"
                                               FontSize="14"
                                               VerticalAlignment="Center"/>
                                </StackPanel>

                                <Border Grid.Row="1" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="10" ClipToBounds="True">
                                    <DataGrid ItemsSource="{Binding MedalRecordRows}"
                                              SelectedItem="{Binding SelectedMedalRecord, Mode=TwoWay}"
                                              AutoGenerateColumns="False"
                                              IsReadOnly="True"
                                              CanUserAddRows="False"
                                              GridLinesVisibility="Horizontal"
                                              HorizontalGridLinesBrush="#F3F4F6"
                                              RowHeight="44"
                                              AlternationCount="2"
                                              BorderThickness="0"
                                              SelectionMode="Single">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="STT" Width="50" Binding="{Binding No}"/>
                                            <DataGridTextColumn Header="Họ tên" Width="150" Binding="{Binding FullName}"/>
                                            <DataGridTextColumn Header="Cấp bậc" Width="90" Binding="{Binding Rank}"/>
                                            <DataGridTextColumn Header="Chức vụ" Width="140" Binding="{Binding Position}"/>
                                            <DataGridTextColumn Header="Đơn vị" Width="160" Binding="{Binding OrgUnit}"/>
                                            <DataGridTextColumn Header="Danh hiệu" Width="300" Binding="{Binding TitleName}"/>
                                            <DataGridTextColumn Header="Số QĐ" Width="200" Binding="{Binding DecisionNumber}"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Bảng nhập -->
                        <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0"
                                           Text="Nhập danh hiệu về hưu"
                                           FontWeight="SemiBold"
                                           Foreground="#1F2937"
                                           FontSize="14"
                                           Margin="0,0,0,12"/>

                                <StackPanel Grid.Row="1" Margin="0,0,0,12">
                                    <TextBlock Text="Họ tên" Style="{StaticResource FormLabelStyle}"/>
                                    <TextBox Text="{Binding MedalRecordFullName, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>

                                <StackPanel Grid.Row="2" Margin="0,0,0,12">
                                    <TextBlock Text="Cấp bậc" Style="{StaticResource FormLabelStyle}"/>
                                    <TextBox Text="{Binding MedalRecordRank, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>

                                <StackPanel Grid.Row="3" Margin="0,0,0,12">
                                    <TextBlock Text="Chức vụ" Style="{StaticResource FormLabelStyle}"/>
                                    <TextBox Text="{Binding MedalRecordPosition, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>

                                <StackPanel Grid.Row="4" Margin="0,0,0,12">
                                    <TextBlock Text="Đơn vị" Style="{StaticResource FormLabelStyle}"/>
                                    <TextBox Text="{Binding MedalRecordOrgUnit, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>

                                <StackPanel Grid.Row="5" Margin="0,0,0,12">
                                    <TextBlock Text="Danh hiệu" Style="{StaticResource FormLabelStyle}"/>
                                    <TextBox Text="{Binding MedalRecordTitleName, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>

                                <StackPanel Grid.Row="6" Margin="0,0,0,16">
                                    <TextBlock Text="Số QĐ" Style="{StaticResource FormLabelStyle}"/>
                                    <TextBox Text="{Binding MedalRecordDecisionNumber, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>

                                <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="↻ Làm mới" Style="{StaticResource BtnGray}"
                                            Command="{Binding ClearMedalRecordFormCommand}"/>
                                    <Button Content="✎ Sửa" Style="{StaticResource BtnGray}"
                                            Command="{Binding EditMedalRecordCommand}"/>
                                    <Button Content="🗑 Xóa" Style="{StaticResource BtnGray}"
                                            Command="{Binding DeleteMedalRecordCommand}"/>
                                    <Button Content="＋ Thêm" Style="{StaticResource BtnPrimary}"
                                            Command="{Binding AddMedalRecordCommand}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </TabItem>

        </TabControl>
    </Grid>
</UserControl>