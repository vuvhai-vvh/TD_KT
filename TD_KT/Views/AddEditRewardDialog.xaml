<Window
    x:Class="TD_KT.Views.AddEditRewardDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Thêm/Sửa nội dung khen thưởng"
    WindowStartupLocation="CenterScreen"
    ResizeMode="NoResize"
    Width="680"
    Height="850"
    WindowStyle="None"
    AllowsTransparency="True"
    Background="Transparent">

    <Window.Resources>
        <Style TargetType="{x:Type TextBox}">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#1F2937"/>
            <Setter Property="CaretBrush" Value="#1F2937"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TextBox}">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" HorizontalAlignment="Stretch"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#94A3B8"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#3B82F6"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type ComboBox}">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style TargetType="{x:Type DatePicker}">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style x:Key="FormLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
    </Window.Resources>

    <Border Background="White" CornerRadius="16" Margin="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.15" Color="#3B82F6"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="56"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="70"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Background="#E54646" CornerRadius="16,16,0,0">
                <Grid Margin="24,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#E54646" CornerRadius="8" Padding="8,6" Margin="0,0,12,0">
                            <TextBlock Text="🏆" FontSize="16" Foreground="White"/>
                        </Border>
                        <TextBlock Text="{Binding Title}" 
                                   Foreground="White" 
                                   FontSize="15" 
                                   FontWeight="Bold" 
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Content="✕" 
                            HorizontalAlignment="Right" 
                            VerticalAlignment="Center"
                            Width="32" Height="32"
                            Background="Transparent"
                            Foreground="White"
                            BorderThickness="0"
                            FontSize="14"
                            Cursor="Hand"
                            Command="{Binding CancelCommand}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border" Background="Transparent" CornerRadius="8">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="#2563EB"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <!-- Form -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="28,24">
                <StackPanel>
                    <!-- Khen thưởng tập thể -->
                    <CheckBox Content="Khen thưởng tập thể"
                              IsChecked="{Binding IsCollectiveReward}"
                              FontSize="13"
                              FontWeight="SemiBold"
                              Foreground="#374151"
                              Margin="0,0,0,18"/>

                    <!-- ================== INDIVIDUAL ================== -->
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCollectiveReward}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <!-- Họ và tên -->
                        <TextBlock Text="Họ và tên *" Style="{StaticResource FormLabelStyle}"/>
                        <ComboBox ItemsSource="{Binding Soldiers}"
                                  SelectedItem="{Binding SelectedSoldier}"
                                  DisplayMemberPath="FullName"
                                  IsEditable="True"
                                  IsTextSearchEnabled="True"
                                  StaysOpenOnEdit="True"
                                  Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}"
                                  Margin="0,0,0,16"/>

                        <!-- Cấp bậc + Năm sinh -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Cấp bậc" Style="{StaticResource FormLabelStyle}"/>
                                <TextBox Text="{Binding Rank, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Năm sinh" Style="{StaticResource FormLabelStyle}"/>
                                <TextBox Text="{Binding BirthYear, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </Grid>

                        <!-- Chức vụ/Đơn vị -->
                        <TextBlock Text="Chức vụ/Đơn vị" Style="{StaticResource FormLabelStyle}"/>
                        <TextBox Text="{Binding PositionUnit, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True" Margin="0,0,0,16"/>

                        <!-- Ngày nhập ngũ -->
                        <TextBlock Text="Ngày nhập ngũ" Style="{StaticResource FormLabelStyle}"/>
                        <DatePicker SelectedDate="{Binding EnlistmentDate, UpdateSourceTrigger=PropertyChanged}" IsEnabled="False" Margin="0,0,0,16"/>

                        <!-- Quê quán -->
                        <TextBlock Text="Quê quán" Style="{StaticResource FormLabelStyle}"/>
                        <TextBox Text="{Binding Hometown}" IsReadOnly="True" Margin="0,0,0,16"/>
                        
                        <!-- Hình thức khen thưởng -->
                        <TextBlock Text="Hình thức khen thưởng *" Style="{StaticResource FormLabelStyle}"/>
                        <ComboBox ItemsSource="{Binding RewardForms}"
                                  SelectedItem="{Binding SelectedRewardForm}"
                                  DisplayMemberPath="Name"
                                  IsEditable="True"
                                  IsTextSearchEnabled="True"
                                  Text="{Binding RewardFormText, UpdateSourceTrigger=PropertyChanged}"
                                  Margin="0,0,0,16"/>

                        <!-- Hoàn cảnh -->
                        <TextBlock Text="Hoàn cảnh" Style="{StaticResource FormLabelStyle}"/>
                        <TextBox Text="{Binding Circumstance, UpdateSourceTrigger=PropertyChanged}" Height="56" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" Padding="12,10" Margin="0,0,0,16"/>

                        <!-- Ghi chú -->
                        <TextBlock Text="Ghi chú" Style="{StaticResource FormLabelStyle}"/>
                        <TextBox Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <!-- ================== COLLECTIVE ================== -->
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCollectiveReward}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <!-- Cơ quan/Đơn vị (tập thể) -->
                        <TextBlock Text="Cơ quan/Đơn vị *" Style="{StaticResource FormLabelStyle}"/>
                        <ComboBox ItemsSource="{Binding OrgUnits}"
                                  SelectedItem="{Binding SelectedCollectiveOrgUnit}"
                                  DisplayMemberPath="Name"
                                  Margin="0,0,0,16"/>

                        <!-- Hình thức khen thưởng -->
                        <TextBlock Text="Hình thức khen thưởng *" Style="{StaticResource FormLabelStyle}"/>
                        <ComboBox ItemsSource="{Binding RewardForms}"
                                  SelectedItem="{Binding SelectedRewardForm}"
                                  DisplayMemberPath="Name"
                                  IsEditable="True"
                                  IsTextSearchEnabled="True"
                                  Text="{Binding RewardFormText, UpdateSourceTrigger=PropertyChanged}"
                                  Margin="0,0,0,16"/>

                        <!-- Ghi chú -->
                        <TextBlock Text="Ghi chú" Style="{StaticResource FormLabelStyle}"/>
                        <TextBox Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- Footer -->
            <Border Grid.Row="2" BorderBrush="#F1F5F9" BorderThickness="0,1,0,0" Background="#F9FAFB" CornerRadius="0,0,16,16">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="24,0">
                    <Button Content="Hủy" Width="110" Height="40" Margin="0,0,12,0" Command="{Binding CancelCommand}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border" Background="#F1F5F9" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1">
                                    <TextBlock Text="Hủy" Foreground="#475569" FontWeight="SemiBold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="#E2E8F0"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button Content="Lưu" Width="110" Height="40" Command="{Binding SaveCommand}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border" Background="#E54646" CornerRadius="8">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="💾" FontSize="13" Margin="0,0,6,0"/>
                                        <TextBlock Text="Lưu" Foreground="White" FontWeight="SemiBold" FontSize="13"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="#2563EB"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
