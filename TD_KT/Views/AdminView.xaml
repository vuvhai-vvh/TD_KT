<UserControl
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:av="http://schemas.microsoft.com/expression/blend/2008" 
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    mc:Ignorable="av"
    x:Class="TD_KT.Views.AdminView" 
    av:DesignHeight="600" 
    av:DesignWidth="1200"
    Background="#F8FAFC">

    <UserControl.Resources>
        <!-- ==================== BUTTON STYLES ==================== -->

        <!-- Primary Button (Blue) -->
        <Style x:Key="BtnPrimary" TargetType="{x:Type Button}">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Background" Value="#3B82F6"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2563EB"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1D4ED8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Button (Gray) -->
        <Style x:Key="BtnGray" TargetType="{x:Type Button}">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E2E8F0"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#CBD5E1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Danger Button (Red) -->
        <Style x:Key="BtnDanger" TargetType="{x:Type Button}">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Background" Value="#EF4444"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#DC2626"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#B91C1C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Catalog Button -->
        <Style x:Key="BtnCatalog" TargetType="{x:Type Button}">
            <Setter Property="Height" Value="80"/>
            <Setter Property="Width" Value="200"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#1F2937"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,16,16"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12"
                                Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.06" Color="#000000"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#EFF6FF"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#3B82F6"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#DBEAFE"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ==================== INPUT STYLES ==================== -->

        <!-- TextBox Style -->
        <Style TargetType="{x:Type TextBox}">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#1F2937"/>
            <Setter Property="CaretBrush" Value="#1F2937"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TextBox}">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" 
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Stretch"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#94A3B8"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#3B82F6"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- PasswordBox Style -->
        <Style TargetType="{x:Type PasswordBox}">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#1F2937"/>
            <Setter Property="CaretBrush" Value="#1F2937"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type PasswordBox}">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" 
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Stretch"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#94A3B8"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#3B82F6"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBox Style -->
        <Style TargetType="{x:Type ComboBox}">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <!-- DatePicker Style -->
        <Style TargetType="{x:Type DatePicker}">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <!-- ==================== CARD STYLES ==================== -->

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.06" Color="#000000"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ==================== DATAGRID STYLES ==================== -->

        <Style x:Key="ModernDataGridStyle" TargetType="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="#F9FAFB"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#F3F4F6"/>
            <Setter Property="VerticalGridLinesBrush" Value="#F3F4F6"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="RowHeight" Value="44"/>
        </Style>

        <!-- DataGrid Column Header Style -->
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="Foreground" Value="#0066CC"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,12"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>

        <!-- DataGrid Cell Style -->
        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#EFF6FF"/>
                    <Setter Property="Foreground" Value="#1E40AF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- DataGrid Row Style -->
        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="White"/>
            <Style.Triggers>
                <Trigger Property="AlternationIndex" Value="1">
                    <Setter Property="Background" Value="#F9FAFB"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F1F5F9"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#EFF6FF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ==================== TAB STYLES ==================== -->

        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}"
                                CornerRadius="10,10,0,0"
                                Padding="{TemplateBinding Padding}"
                                Margin="{TemplateBinding Margin}">
                            <ContentPresenter ContentSource="Header" 
                                              HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="border" Property="Background" Value="White"/>
                                <Setter Property="Foreground" Value="#3B82F6"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E2E8F0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Form Label Style -->
        <Style x:Key="FormLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <!-- Section Title Style -->
        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#1F2937"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>

    </UserControl.Resources>

    <Grid Margin="24,20">
        <TabControl x:Name="adminTabControl">

            <!-- ================= TAB 1: TÀI KHOẢN ================= -->
            <TabItem x:Name="tabAccounts" Header="📋  Tài khoản">
                <Border Background="White" CornerRadius="0,12,12,12" Padding="20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="360"/>
                        </Grid.ColumnDefinitions>

                        <!-- DANH SÁCH -->
                        <Grid Grid.Column="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Header -->
                            <DockPanel Margin="0,0,0,16" LastChildFill="False">
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                                    <TextBlock Text="📑" FontSize="18" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="Danh sách tài khoản" Style="{StaticResource SectionTitleStyle}" Margin="0"/>
                                </StackPanel>
                                <Button Content="↻  Tải lại"
                                        Style="{StaticResource BtnGray}"
                                        DockPanel.Dock="Right"
                                        Click="BtnReloadAccounts_Click"/>
                            </DockPanel>

                            <!-- BỘ LỌC -->
                            <Border Grid.Row="1" Background="#F8FAFC" CornerRadius="10" Padding="16" Margin="0,0,0,16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Vai trò" Style="{StaticResource FormLabelStyle}"/>
                                        <ComboBox x:Name="cboRoleFilter"
                                                  ItemsSource="{Binding RoleOptions}"
                                                  SelectedItem="{Binding RoleFilter, Mode=TwoWay}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Đơn vị" Style="{StaticResource FormLabelStyle}"/>
                                        <ComboBox x:Name="cboOrgUnitFilter"
                                                  ItemsSource="{Binding OrgUnitsForFilter}"
                                                  DisplayMemberPath="Name"
                                                  IsEditable="True"
                                                  IsTextSearchEnabled="True"
                                                  StaysOpenOnEdit="True"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="🔍 Tìm kiếm" Style="{StaticResource FormLabelStyle}"/>
                                        <TextBox x:Name="txtAccountSearch"
                                                 Text="{Binding AccountSearchText, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- DATAGRID -->
                            <Border Grid.Row="2" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="10" ClipToBounds="True">
                                <DataGrid x:Name="dgAccounts"
                                          ItemsSource="{Binding AccountsView}"
                                          SelectedItem="{Binding SelectedAccount, Mode=TwoWay}"
                                          Style="{StaticResource ModernDataGridStyle}"
                                          AlternationCount="2">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="STT" Width="55" Binding="{Binding Stt}">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                                    <Setter Property="Foreground" Value="#6B7280"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="Tên đăng nhập" Width="130" Binding="{Binding Username}">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="FontWeight" Value="Medium"/>
                                                    <Setter Property="Foreground" Value="#1F2937"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="Tên hiển thị" Width="160" Binding="{Binding DisplayName}"/>
                                        <DataGridTextColumn Header="Vai trò" Width="90" Binding="{Binding Role}">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#3B82F6"/>
                                                    <Setter Property="FontWeight" Value="Medium"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="Cơ quan/Đơn vị" Width="180" Binding="{Binding OrgUnit}"/>
                                        <DataGridTextColumn Header="Chức vụ" Width="130" Binding="{Binding Position}"/>
                                        <DataGridTextColumn Header="Trạng thái" Width="*" Binding="{Binding Status}"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Border>

                            <!-- Footer -->
                            <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,12,0,0">
                                <TextBlock Text="Tổng số: " Foreground="#6B7280" FontSize="12" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Accounts.Count, FallbackValue=0}" 
                                           Foreground="#1F2937" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                                <TextBlock Text=" tài khoản" Foreground="#6B7280" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <!-- FORM NHẬP LIỆU -->
                        <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Form Header -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                                    <Border Background="#3B82F6" CornerRadius="8" Padding="10,6" Margin="0,0,12,0">
                                        <TextBlock Text="✏️" Foreground="White" FontSize="14"/>
                                    </Border>
                                    <TextBlock Text="Nhập liệu tài khoản"
                                               Style="{StaticResource SectionTitleStyle}"
                                               VerticalAlignment="Center"
                                               Margin="0"/>
                                </StackPanel>

                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <TextBlock Text="Tên đăng nhập *" Style="{StaticResource FormLabelStyle}"/>
                                        <TextBox x:Name="txtAccUserName"/>

                                        <TextBlock Text="Tên hiển thị *" Style="{StaticResource FormLabelStyle}" Margin="0,16,0,6"/>
                                        <TextBox x:Name="txtAccDisplayName"/>

                                        <TextBlock Text="Mật khẩu *" Style="{StaticResource FormLabelStyle}" Margin="0,16,0,6"/>
                                        <PasswordBox x:Name="txtAccPassword"/>
                                        <TextBlock Text="💡 Khi sửa: để trống = không đổi mật khẩu" 
                                                   Foreground="#94A3B8" 
                                                   FontSize="11" 
                                                   Margin="0,4,0,0"/>

                                        <TextBlock Text="Vai trò *" Style="{StaticResource FormLabelStyle}" Margin="0,16,0,6"/>
                                        <ComboBox x:Name="cboAccRole"
                                                  ItemsSource="{Binding RoleOptionsForm}"/>

                                        <TextBlock Text="Cơ quan/Đơn vị *" Style="{StaticResource FormLabelStyle}" Margin="0,16,0,6"/>
                                        <ComboBox x:Name="cboAccOrgUnit"
                                                  ItemsSource="{Binding OrgUnitsForFilter}"
                                                  DisplayMemberPath="Name"
                                                  IsEditable="True"
                                                  IsTextSearchEnabled="True"
                                                  StaysOpenOnEdit="True"/>

                                        <TextBlock Text="Chức vụ *" Style="{StaticResource FormLabelStyle}" Margin="0,16,0,6"/>
                                        <ComboBox x:Name="cboAccPosition"
                                                  ItemsSource="{Binding PositionsForFilter}"
                                                  DisplayMemberPath="Name"
                                                  IsEditable="True"
                                                  IsTextSearchEnabled="True"
                                                  StaysOpenOnEdit="True"/>

                                        <TextBlock Text="Trạng thái" Style="{StaticResource FormLabelStyle}" Margin="0,16,0,6"/>
                                        <ComboBox x:Name="cboAccStatus"/>
                                    </StackPanel>
                                </ScrollViewer>

                                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                                    <Button Content="+ Thêm" Style="{StaticResource BtnPrimary}" Click="BtnAddAccount_Click"/>
                                    <Button Content="✎ Sửa" Style="{StaticResource BtnGray}" Click="BtnEditAccount_Click"/>
                                    <Button Content="🗑 Xóa" Style="{StaticResource BtnDanger}" Click="BtnDeleteAccount_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </TabItem>

            <!-- ================= TAB 2: PHÂN QUYỀN ================= -->
            <TabItem x:Name="tabPermissions" Header="🔐  Phân quyền">
                <Border Background="White" CornerRadius="0,12,12,12" Padding="20">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>

                            <!-- PHÂN QUYỀN USER -->
                            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,20">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                        <Border Background="#10B981" CornerRadius="8" Padding="10,6" Margin="0,0,12,0">
                                            <TextBlock Text="👤" Foreground="White" FontSize="14"/>
                                        </Border>
                                        <TextBlock Text="User: phân quyền xem / thao tác theo 4 mặt công tác"
                                                   Style="{StaticResource SectionTitleStyle}"
                                                   VerticalAlignment="Center"
                                                   Margin="0"/>
                                    </StackPanel>

                                    <Border BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="10" ClipToBounds="True">
                                        <DataGrid x:Name="dgUserPermissions"
                                                  ItemsSource="{Binding Permissions.UserPermissions}"
                                                  Style="{StaticResource ModernDataGridStyle}"
                                                  IsReadOnly="False"
                                                  HorizontalScrollBarVisibility="Auto"
                                                  AlternationCount="2">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="STT" Width="50" IsReadOnly="True" Binding="{Binding Stt}"/>
                                                <DataGridTextColumn Header="Tên đăng nhập" Width="130" IsReadOnly="True" Binding="{Binding Username}"/>
                                                <DataGridTextColumn Header="Cơ quan/Đơn vị" Width="180" IsReadOnly="True" Binding="{Binding OrgUnit}"/>
                                                <DataGridTextColumn Header="Chức vụ" Width="130" IsReadOnly="True" Binding="{Binding Position}"/>
                                                <DataGridCheckBoxColumn Header="Xem TM" Width="75" Binding="{Binding ViewTM, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                <DataGridCheckBoxColumn Header="Thao tác TM" Width="95" Binding="{Binding EditTM, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                <DataGridCheckBoxColumn Header="Xem CT" Width="75" Binding="{Binding ViewCT, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                <DataGridCheckBoxColumn Header="Thao tác CT" Width="95" Binding="{Binding EditCT, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                <DataGridCheckBoxColumn Header="Xem HCKT" Width="85" Binding="{Binding ViewHCKT, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                <DataGridCheckBoxColumn Header="Thao tác HCKT" Width="105" Binding="{Binding EditHCKT, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                <DataGridCheckBoxColumn Header="Xem NV" Width="75" Binding="{Binding ViewNV, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                <DataGridCheckBoxColumn Header="Thao tác NV" Width="95" Binding="{Binding EditNV, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                <DataGridCheckBoxColumn Header="Xác nhận điểm" Width="120" Binding="{Binding CanFinalizeScore, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- PHÂN QUYỀN ADMIN -->
                            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,20">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                        <Border Background="#F59E0B" CornerRadius="8" Padding="10,6" Margin="0,0,12,0">
                                            <TextBlock Text="👑" Foreground="White" FontSize="14"/>
                                        </Border>
                                        <TextBlock Text="Admin: quyền vào Tài khoản / Phân quyền"
                                                   Style="{StaticResource SectionTitleStyle}"
                                                   VerticalAlignment="Center"
                                                   Margin="0"/>
                                    </StackPanel>

                                    <Border BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="10" ClipToBounds="True">
                                        <DataGrid x:Name="dgAdminPermissions"
                                                  ItemsSource="{Binding Permissions.AdminPermissions}"
                                                  Style="{StaticResource ModernDataGridStyle}"
                                                  IsReadOnly="False"
                                                  AlternationCount="2">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="STT" Width="50" IsReadOnly="True" Binding="{Binding Stt}"/>
                                                <DataGridTextColumn Header="Tên đăng nhập" Width="130" IsReadOnly="True" Binding="{Binding Username}"/>
                                                <DataGridTextColumn Header="Cơ quan/Đơn vị" Width="180" IsReadOnly="True" Binding="{Binding OrgUnit}"/>
                                                <DataGridTextColumn Header="Chức vụ" Width="*" IsReadOnly="True" Binding="{Binding Position}"/>
                                                <DataGridCheckBoxColumn Header="Tài khoản" Width="110" Binding="{Binding CanAccessAccountTab, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                <DataGridCheckBoxColumn Header="Phân quyền" Width="110" Binding="{Binding CanAccessPermissionTab, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                <DataGridCheckBoxColumn Header="Xác nhận điểm" Width="120" Binding="{Binding CanFinalizeScore, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                <DataGridCheckBoxColumn Header="Khóa tuần" Width="110" Binding="{Binding CanLockWeek, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- NÚT CHỨC NĂNG -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="↻  Tải lại" Style="{StaticResource BtnGray}" Command="{Binding Permissions.ReloadCommand}"/>
                                <Button Content="💾  Lưu phân quyền" Style="{StaticResource BtnPrimary}" Margin="0" Command="{Binding Permissions.SaveCommand}"/>
                            </StackPanel>

                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </TabItem>

            <!-- ================= TAB 3: HỒ SƠ QUÂN NHÂN ================= -->
            <TabItem Header="🎖️  Hồ sơ quân nhân">
                <Border Background="White" CornerRadius="0,12,12,12" Padding="20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="380"/>
                        </Grid.ColumnDefinitions>

                        <!-- DANH SÁCH -->
                        <Grid Grid.Column="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Header -->
                            <DockPanel Margin="0,0,0,16" LastChildFill="False">
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                                    <TextBlock Text="🎖️" FontSize="18" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="Danh sách hồ sơ quân nhân" Style="{StaticResource SectionTitleStyle}" Margin="0"/>
                                </StackPanel>
                                <Button Content="↻  Tải lại"
                                        Style="{StaticResource BtnGray}"
                                        DockPanel.Dock="Right"
                                        Command="{Binding ReloadSoldiersCommand}"/>
                            </DockPanel>

                            <!-- BỘ LỌC & TÌM KIẾM -->
                            <Border Grid.Row="1" Background="#F8FAFC" CornerRadius="10" Padding="16" Margin="0,0,0,16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Đơn vị" Style="{StaticResource FormLabelStyle}"/>
                                        <ComboBox x:Name="cboGroupFilter"
                                                  ItemsSource="{Binding OrgUnitsForFilter}"
                                                  DisplayMemberPath="Name"
                                                  SelectedItem="{Binding SelectedGroupFilter, Mode=TwoWay}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Nhóm đối tượng" Style="{StaticResource FormLabelStyle}"/>
                                        <ComboBox x:Name="cboSubjectGroupFilter"
                                                  ItemsSource="{Binding SubjectGroupOptions}"
                                                  SelectedItem="{Binding SelectedSubjectGroupFilter, Mode=TwoWay}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="Cấp bậc" Style="{StaticResource FormLabelStyle}"/>
                                        <ComboBox x:Name="cboRankFilter"
                                                  ItemsSource="{Binding RanksForFilter}"
                                                  DisplayMemberPath="Name"
                                                  SelectedItem="{Binding SelectedRankFilter, Mode=TwoWay}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="6">
                                        <TextBlock Text="Chức vụ" Style="{StaticResource FormLabelStyle}"/>
                                        <ComboBox x:Name="cboPositionFilter"
                                                  ItemsSource="{Binding PositionsForFilter}"
                                                  DisplayMemberPath="Name"
                                                  SelectedItem="{Binding SelectedPositionFilter, Mode=TwoWay}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="8">
                                        <TextBlock Text="🔍 Tìm theo họ tên" Style="{StaticResource FormLabelStyle}"/>
                                        <TextBox x:Name="txtSoldierSearch" Text="{Binding SoldierSearchText, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- DATAGRID -->
                            <Border Grid.Row="2" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="10" ClipToBounds="True">
                                <DataGrid x:Name="dgSoldiers"
                                          ItemsSource="{Binding SoldiersView}"
                                          SelectedItem="{Binding SelectedSoldier, Mode=TwoWay}"
                                          Style="{StaticResource ModernDataGridStyle}"
                                          AlternationCount="2">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="STT" Width="55" Binding="{Binding Stt}">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                                    <Setter Property="Foreground" Value="#6B7280"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="Họ tên" Width="160" Binding="{Binding FullName}">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="FontWeight" Value="Medium"/>
                                                    <Setter Property="Foreground" Value="#1F2937"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="Năm sinh" Width="80" Binding="{Binding BirthYear}">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                                    <Setter Property="Foreground" Value="#374151"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="Quê quán" Width="300" Binding="{Binding Hometown}"/>
                                        <DataGridTextColumn Header="CCCD" Width="140" Binding="{Binding CitizenId}"/>
                                        <DataGridTextColumn Header="Nhóm ĐT" Width="100" Binding="{Binding SubjectGroup}"/>
                                        <DataGridTextColumn Header="Cấp bậc" Width="100" Binding="{Binding Rank}"/>
                                        <DataGridTextColumn Header="Chức vụ" Width="120" Binding="{Binding Position}"/>
                                        <DataGridTextColumn Header="Cơ quan/Đơn vị" Width="180" Binding="{Binding OrgUnit}"/>
                                        <DataGridTextColumn Header="Ngày nhập ngũ" Width="120" Binding="{Binding EnlistmentDateDisplay}"/>
                                        <DataGridTextColumn Header="Năm phục vụ" Width="200" Binding="{Binding ServiceDurationText}">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#3B82F6"/>
                                                    <Setter Property="FontWeight" Value="Medium"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Border>

                            <!-- Footer -->
                            <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,12,0,0">
                                <TextBlock Text="Tổng số: " Foreground="#6B7280" FontSize="12" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Soldiers.Count, FallbackValue=0}" 
                                           Foreground="#1F2937" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                                <TextBlock Text=" quân nhân" Foreground="#6B7280" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <!-- FORM NHẬP LIỆU -->
                        <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Form Header -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                                    <Border Background="#10B981" CornerRadius="8" Padding="10,6" Margin="0,0,12,0">
                                        <TextBlock Text="✏️" Foreground="White" FontSize="14"/>
                                    </Border>
                                    <TextBlock Text="Nhập liệu hồ sơ quân nhân"
                                               Style="{StaticResource SectionTitleStyle}"
                                               VerticalAlignment="Center"
                                               Margin="0"/>
                                </StackPanel>

                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <TextBlock Text="Họ tên *" Style="{StaticResource FormLabelStyle}"/>
                                        <TextBox x:Name="txtSoldierFullName" Text="{Binding SoldierFullName, UpdateSourceTrigger=PropertyChanged}"/>

                                        <TextBlock Text="Năm sinh" Style="{StaticResource FormLabelStyle}" Margin="0,16,0,6"/>
                                        <TextBox x:Name="txtSoldierBirthYear" Text="{Binding SoldierBirthYear, UpdateSourceTrigger=PropertyChanged}"/>

                                        <TextBlock Text="Quê quán" Style="{StaticResource FormLabelStyle}" Margin="0,16,0,6"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="50"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="txtSoldierHometown"
                                                     Grid.Column="0"
                                                     Text="{Binding SoldierHometown, UpdateSourceTrigger=PropertyChanged}"
                                                     IsReadOnly="True"/>
                                            <Button Grid.Column="1"
                                                    Content="📍"
                                                    Width="40"
                                                    Height="38"
                                                    Margin="8,0,0,0"
                                                    Command="{Binding PickSoldierHometownCommand}"/>
                                        </Grid>
                                        <TextBlock Text="CCCD" Style="{StaticResource FormLabelStyle}" Margin="0,16,0,6"/>
                                        <TextBox x:Name="txtSoldierCitizenId" Text="{Binding SoldierCitizenId, UpdateSourceTrigger=PropertyChanged}"/>

                                        <TextBlock Text="Nhóm đối tượng" Style="{StaticResource FormLabelStyle}" Margin="0,16,0,6"/>
                                        <ComboBox x:Name="cboSoldierSubjectGroup"
                                                  ItemsSource="{Binding SubjectGroupOptionsForm}"
                                                  SelectedItem="{Binding SoldierSubjectGroup, Mode=TwoWay}"/>

                                        <TextBlock Text="Cấp bậc" Style="{StaticResource FormLabelStyle}" Margin="0,16,0,6"/>
                                        <ComboBox x:Name="cboSoldierRank"
                                                  ItemsSource="{Binding RanksForFilter}"
                                                  DisplayMemberPath="Name"
                                                  SelectedItem="{Binding SoldierRank, Mode=TwoWay}"
                                                  IsEditable="True"
                                                  IsTextSearchEnabled="True"
                                                  StaysOpenOnEdit="True"/>

                                        <TextBlock Text="Chức vụ" Style="{StaticResource FormLabelStyle}" Margin="0,16,0,6"/>
                                        <ComboBox x:Name="cboSoldierPosition"
                                                  ItemsSource="{Binding PositionsForFilter}"
                                                  DisplayMemberPath="Name"
                                                  SelectedItem="{Binding SoldierPosition, Mode=TwoWay}"
                                                  IsEditable="True"
                                                  IsTextSearchEnabled="True"
                                                  StaysOpenOnEdit="True"/>

                                        <TextBlock Text="Nhóm (Cơ quan)" Style="{StaticResource FormLabelStyle}" Margin="0,16,0,6"/>
                                        <ComboBox x:Name="cboSoldierGroup"
                                                  ItemsSource="{Binding OrgUnitsForFilter}"
                                                  DisplayMemberPath="Name"
                                                  SelectedItem="{Binding SoldierGroup, Mode=TwoWay}"/>

                                        <TextBlock Text="Đơn vị trực thuộc" Style="{StaticResource FormLabelStyle}" Margin="0,16,0,6"/>
                                        <ComboBox x:Name="cboSoldierUnit"
                                                  ItemsSource="{Binding SoldierUnitOptions}"
                                                  DisplayMemberPath="Name"
                                                  SelectedItem="{Binding SoldierUnit, Mode=TwoWay}"/>

                                        <TextBlock Text="Ngày nhập ngũ/công tác" Style="{StaticResource FormLabelStyle}" Margin="0,16,0,6"/>
                                        <DatePicker x:Name="dpSoldierEnlistmentDate" SelectedDate="{Binding SoldierEnlistmentDate, Mode=TwoWay}"/>

                                    </StackPanel>
                                </ScrollViewer>

                                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                                    <Button Content="+ Thêm" Style="{StaticResource BtnPrimary}" Command="{Binding AddSoldierCommand}"/>
                                    <Button Content="✎ Sửa" Style="{StaticResource BtnGray}" Command="{Binding EditSoldierCommand}"/>
                                    <Button Content="🗑 Xóa" Style="{StaticResource BtnDanger}" Command="{Binding DeleteSoldierCommand}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </TabItem>

            <!-- ================= TAB 4: DANH MỤC ================= -->
            <TabItem Header="📂  Danh mục">
                <Border Background="White" CornerRadius="0,12,12,12" Padding="24">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                            <Border Background="#8B5CF6" CornerRadius="8" Padding="10,6" Margin="0,0,12,0">
                                <TextBlock Text="📂" Foreground="White" FontSize="14"/>
                            </Border>
                            <TextBlock Text="Chọn danh mục cần quản lý"
                                       Style="{StaticResource SectionTitleStyle}"
                                       VerticalAlignment="Center"
                                       Margin="0"/>
                        </StackPanel>

                        <WrapPanel Orientation="Horizontal">
                            <Button Content="🏢  Cơ quan/Đơn vị" 
                                    Style="{StaticResource BtnCatalog}"
                                    Command="{Binding Catalog.OpenOrgUnitDialogCommand}"/>

                            <Button Content="💼  Chức vụ" 
                                    Style="{StaticResource BtnCatalog}"
                                    Command="{Binding Catalog.OpenPositionDialogCommand}"/>

                            <Button Content="📍  Quê quán" 
                                    Style="{StaticResource BtnCatalog}"
                                    Command="{Binding Catalog.OpenHometownDialogCommand}"/>

                            <Button Content="🏆  Hình thức khen thưởng" 
                                    Style="{StaticResource BtnCatalog}"
                                    Command="{Binding Catalog.OpenRewardFormDialogCommand}"/>

                            <Button Content="⚙️  Cấu hình giới thiệu" 
                                    Style="{StaticResource BtnCatalog}"
                                    Width="200"
                                    Command="{Binding Catalog.OpenIntroConfigDialogCommand}"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </TabItem>

        </TabControl>
    </Grid>
</UserControl>
