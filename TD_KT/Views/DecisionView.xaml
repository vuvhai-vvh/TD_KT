<UserControl
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="TD_KT.Views.DecisionView"
    Background="#F8FAFC">

    <UserControl.Resources>
        <!-- ==================== BUTTON STYLES ==================== -->
        <Style x:Key="BtnPrimary" TargetType="{x:Type Button}">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Background" Value="#3B82F6"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2563EB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BtnGray" TargetType="{x:Type Button}">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E2E8F0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BtnDanger" TargetType="{x:Type Button}">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Background" Value="#EF4444"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#DC2626"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BtnSuccess" TargetType="{x:Type Button}">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Background" Value="#10B981"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#059669"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ==================== INPUT STYLES ==================== -->
        <Style TargetType="{x:Type TextBox}">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#1F2937"/>
            <Setter Property="CaretBrush" Value="#1F2937"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TextBox}">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" HorizontalAlignment="Stretch"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#3B82F6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type ComboBox}">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style TargetType="{x:Type DatePicker}">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <!-- ==================== DATAGRID STYLES ==================== -->
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#EFF6FF"/>
                    <Setter Property="Foreground" Value="#1E40AF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="White"/>
            <Style.Triggers>
                <Trigger Property="AlternationIndex" Value="1">
                    <Setter Property="Background" Value="#F9FAFB"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F1F5F9"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#EFF6FF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FormLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.06"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#1F2937"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
            <Border Background="#3B82F6" CornerRadius="10" Padding="12,8" Margin="0,0,14,0">
                <TextBlock Text="📜" FontSize="18" Foreground="White"/>
            </Border>
            <TextBlock Text="QUẢN LÝ QUYẾT ĐỊNH KHEN THƯỞNG"
                       FontSize="20"
                       FontWeight="Bold"
                       Foreground="#1F2937"
                       VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Lọc năm/tháng -->
        <Border Grid.Row="1" Background="#F8FAFC" CornerRadius="10" Padding="16" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Năm:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,10,0" FontSize="13"/>
                <ComboBox Width="120"
                          ItemsSource="{Binding YearOptions}"
                          SelectedItem="{Binding SelectedYearOption}"
                          DisplayMemberPath="Name"
                          Margin="0,0,20,0"/>

                <TextBlock Text="Tháng:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,10,0" FontSize="13"/>
                <ComboBox Width="100"
                          ItemsSource="{Binding MonthOptions}"
                          SelectedItem="{Binding SelectedMonthOption}"
                          DisplayMemberPath="Name"
                          Margin="0,0,20,0"/>

                <Button Content="↻ Làm mới"
                        Style="{StaticResource BtnGray}"
                        Margin="0"
                        Command="{Binding RefreshDecisionStateCommand}"/>
            </StackPanel>
        </Border>

        <!-- Nội dung chính: Trái (Thông tin QĐ) + Phải (Danh sách khen thưởng) -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- BÊN TRÁI: Thông tin quyết định -->
            <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
                        <Border Background="#8B5CF6" CornerRadius="6" Padding="8,4" Margin="0,0,10,0">
                            <TextBlock Text="📋" FontSize="12" Foreground="White"/>
                        </Border>
                        <TextBlock Text="THÔNG TIN QUYẾT ĐỊNH" Style="{StaticResource SectionHeaderStyle}"/>
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Số quyết định *" Style="{StaticResource FormLabelStyle}"/>
                            <ComboBox Margin="0,0,0,14"
                                      ItemsSource="{Binding Decisions}"
                                      SelectedItem="{Binding SelectedDecision}"
                                      DisplayMemberPath="DisplayText"
                                      IsEditable="True"
                                      IsTextSearchEnabled="False"
                                      StaysOpenOnEdit="True"
                                      Text="{Binding DecisionNumberText, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Text="Cấp khen thưởng" Style="{StaticResource FormLabelStyle}"/>
                            <TextBox Margin="0,0,0,14"
                                     IsReadOnly="True"
                                     Text="{Binding SelectedIssuingLevel.Name}"/>

                            <TextBlock Text="Người ký" Style="{StaticResource FormLabelStyle}"/>
                            <TextBox Margin="0,0,0,14" IsReadOnly="True" Text="{Binding Signer}"/>

                            <TextBlock Text="Ngày ký" Style="{StaticResource FormLabelStyle}"/>
                            <DatePicker Margin="0,0,0,14" IsEnabled="False" SelectedDate="{Binding SignedDate}"/>

                            <TextBlock Text="Ghi chú" Style="{StaticResource FormLabelStyle}"/>
                            <TextBox Height="65"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     VerticalContentAlignment="Top"
                                     Padding="12,10"
                                     IsReadOnly="True"
                                     Text="{Binding Note}"/>
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel Grid.Row="2" Margin="0,16,0,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch">
                            <Button Content="✚ Thêm QD"
                                    Style="{StaticResource BtnSuccess}"
                                    Margin="0,0,8,0"
                                    Command="{Binding AddDecisionCommand}"/>
                            <Button Content="✎ Sửa/Xóa QD"
                                    Style="{StaticResource BtnGray}"
                                    Command="{Binding EditDecisionCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- BÊN PHẢI: Danh sách khen thưởng -->
            <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="180"/>
                    </Grid.RowDefinitions>

                    <!-- Header + Nút -->
                    <DockPanel Grid.Row="0" Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                            <Border Background="#F59E0B" CornerRadius="6" Padding="8,4" Margin="0,0,10,0">
                                <TextBlock Text="🏆" FontSize="12" Foreground="White"/>
                            </Border>
                            <TextBlock Text="DANH SÁCH KHEN THƯỞNG" Style="{StaticResource SectionHeaderStyle}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                            <Button Content="+ Thêm dòng" Style="{StaticResource BtnPrimary}" Command="{Binding AddDetailCommand}"/>
                            <Button Content="✎ Sửa dòng" Style="{StaticResource BtnGray}" Command="{Binding EditDetailCommand}"/>
                            <Button Content="🗑 Xóa dòng" Style="{StaticResource BtnDanger}" Command="{Binding DeleteDetailCommand}"/>
                        </StackPanel>
                    </DockPanel>

                    <!-- DataGrid -->
                    <Border Grid.Row="1" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="10" ClipToBounds="True">
                        <DataGrid ItemsSource="{Binding DecisionDetails}"
                                  SelectedItem="{Binding SelectedDetail}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#F3F4F6"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  SelectionMode="Single"
                                  RowHeight="42"
                                  AlternationCount="2"
                                  BorderThickness="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="STT" Width="45" Binding="{Binding STT}"/>
                                <DataGridTextColumn Header="Họ và tên" Width="140" Binding="{Binding HoTen}"/>
                                <DataGridTextColumn Header="Cấp bậc" Width="80" Binding="{Binding CapBac}"/>
                                <DataGridTextColumn Header="Chức vụ/Đơn vị" Width="250" Binding="{Binding ChucVuDonVi}"/>
                                <DataGridTextColumn Header="Năm sinh" Width="100" Binding="{Binding NamSinh}"/>
                                <DataGridTextColumn Header="Nhập ngũ" Width="100" Binding="{Binding NhapNgu}"/>
                                <DataGridTextColumn Header="Quê quán" Width="280" Binding="{Binding QueQuan}"/>
                                <DataGridTextColumn Header="Hình thức KT" Width="180" Binding="{Binding HinhThucKT}"/>
                                <DataGridTextColumn Header="Hoàn cảnh" Width="100" Binding="{Binding HoanCanh}"/>
                                <DataGridTextColumn Header="Ghi chú" Width="200" Binding="{Binding GhiChu}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <!-- File đính kèm -->
                    <Border Grid.Row="2" Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,16,0,10">
                        <TextBlock Foreground="#065F46" FontWeight="SemiBold"
                                   Text="{Binding SelectedDetail.HoTen, StringFormat=File đính kèm cho: {0}, TargetNullValue=Vui lòng chọn 1 cá nhân/tập thể trong danh sách khen thưởng để xem file đính kèm.}"/>
                    </Border>

                    <DockPanel Grid.Row="2" Margin="0,60,0,10">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                            <Border Background="#10B981" CornerRadius="6" Padding="8,4" Margin="0,0,10,0">
                                <TextBlock Text="📎" FontSize="12" Foreground="White"/>
                            </Border>
                            <TextBlock Text="FILE ĐÍNH KÈM" Style="{StaticResource SectionHeaderStyle}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                            <Button Content="+ Thêm" Style="{StaticResource BtnPrimary}" Command="{Binding AddAttachmentCommand}"/>
                            <Button Content="🗑 Xóa" Style="{StaticResource BtnDanger}" Margin="0,0,8,0" Command="{Binding DeleteAttachmentCommand}"/>
                            <Button Content="👁 Mở xem" Style="{StaticResource BtnGray}" Command="{Binding OpenAttachmentCommand}"/>
                            <Button Content="⬇ Tải xuống" Style="{StaticResource BtnGray}" Margin="0" Command="{Binding DownloadAttachmentCommand}"/>
                        </StackPanel>
                    </DockPanel>

                    <Border Grid.Row="3" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="10" ClipToBounds="True">
                        <DataGrid ItemsSource="{Binding DecisionAttachments}"
                                  SelectedItem="{Binding SelectedAttachment}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#F3F4F6"
                                  SelectionMode="Single"
                                  RowHeight="42"
                                  AlternationCount="2"
                                  BorderThickness="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Tên file" Width="*" Binding="{Binding FileName}"/>
                                <DataGridTextColumn Header="Ngày tải lên" Width="*" Binding="{Binding UploadDateText}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
