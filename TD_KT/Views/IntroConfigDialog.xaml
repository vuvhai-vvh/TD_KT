<Window x:Class="TD_KT.Views.IntroConfigDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cấu hình giới thiệu thi đua"
        Width="1250" Height="900"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="#F8FAFC">

    <Window.Resources>
        <Style x:Key="BtnPrimary" TargetType="{x:Type Button}">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Background" Value="#3B82F6"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2563EB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BtnGray" TargetType="{x:Type Button}">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E2E8F0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BtnDanger" TargetType="{x:Type Button}">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Background" Value="#EF4444"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#DC2626"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type TextBox}">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#1F2937"/>
            <Setter Property="CaretBrush" Value="#1F2937"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TextBox}">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" HorizontalAlignment="Stretch"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#3B82F6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#EFF6FF"/>
                    <Setter Property="Foreground" Value="#1E40AF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="White"/>
            <Style.Triggers>
                <Trigger Property="AlternationIndex" Value="1">
                    <Setter Property="Background" Value="#F9FAFB"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F1F5F9"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#EFF6FF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FormLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.06"/>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="White" CornerRadius="12" Margin="16">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.08"/>
        </Border.Effect>

        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
                <Border Background="#8B5CF6" CornerRadius="10" Padding="12,8" Margin="0,0,14,0">
                    <TextBlock Text="⚙️" FontSize="18" Foreground="White"/>
                </Border>
                <StackPanel>
                    <TextBlock Text="Cấu hình nội dung giới thiệu thi đua" FontSize="18" FontWeight="Bold" Foreground="#1F2937"/>
                    <TextBlock Text="Nội dung này sẽ hiển thị tại: Trang chủ" Foreground="#6B7280" FontSize="12" Margin="0,4,0,0"/>
                </StackPanel>
            </StackPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <Border Background="#3B82F6" CornerRadius="6" Padding="10,5" Margin="0,0,12,0">
                                    <TextBlock Text="1" FontWeight="Bold" Foreground="White" FontSize="13"/>
                                </Border>
                                <TextBlock Text="Chức năng, nhiệm vụ và quyền hạn của Hội đồng thi đua" FontWeight="SemiBold" Foreground="#1F2937" FontSize="14" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBox x:Name="txtCouncilFunctions" Height="100" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" Text="{Binding CouncilFunctions, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <Border Background="#10B981" CornerRadius="6" Padding="10,5" Margin="0,0,12,0">
                                    <TextBlock Text="2" FontWeight="Bold" Foreground="White" FontSize="13"/>
                                </Border>
                                <TextBlock Text="Danh sách Hội đồng thi đua" FontWeight="SemiBold" Foreground="#1F2937" FontSize="14" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="300"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
                                    <DataGrid x:Name="dgCouncilMembers" Height="180" AutoGenerateColumns="False" CanUserAddRows="False" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F3F4F6" SelectionMode="Single" IsReadOnly="True" RowHeight="40" AlternationCount="2" BorderThickness="0" ItemsSource="{Binding CouncilMembers}" SelectedItem="{Binding SelectedCouncilMember, Mode=TwoWay}" SelectionChanged="DgCouncilMembers_SelectionChanged">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="STT" Width="50" Binding="{Binding Stt}"/>
                                            <DataGridTextColumn Header="Họ tên" Width="150" Binding="{Binding FullName}"/>
                                            <DataGridTextColumn Header="Cấp bậc" Width="100" Binding="{Binding Rank}"/>
                                            <DataGridTextColumn Header="Chức vụ" Width="140" Binding="{Binding Position}"/>
                                            <DataGridTextColumn Header="Vai trò trong HĐ" Width="*" Binding="{Binding Role}"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Border>
                                <Border Grid.Column="2" Background="#F9FAFB" CornerRadius="10" Padding="16">
                                    <StackPanel>
                                        <TextBlock Text="Nhập liệu thành viên" FontWeight="SemiBold" Foreground="#1F2937" FontSize="13" Margin="0,0,0,12"/>
                                        <TextBlock Text="Họ tên" Style="{StaticResource FormLabelStyle}"/>
                                        <TextBox x:Name="txtCouncilFullName"/>
                                        <TextBlock Text="Cấp bậc" Style="{StaticResource FormLabelStyle}" Margin="0,12,0,6"/>
                                        <TextBox x:Name="txtCouncilRank"/>
                                        <TextBlock Text="Chức vụ" Style="{StaticResource FormLabelStyle}" Margin="0,12,0,6"/>
                                        <TextBox x:Name="txtCouncilPosition"/>
                                        <TextBlock Text="Vai trò trong HĐ" Style="{StaticResource FormLabelStyle}" Margin="0,12,0,6"/>
                                        <TextBox x:Name="txtCouncilRole"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                            <Button Content="+ Thêm" Style="{StaticResource BtnPrimary}" Click="BtnAddCouncilMember_Click"/>
                                            <Button Content="✎ Sửa" Style="{StaticResource BtnGray}" Click="BtnEditCouncilMember_Click"/>
                                            <Button Content="🗑 Xóa" Style="{StaticResource BtnDanger}" Click="BtnDeleteCouncilMember_Click"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <Border Background="#F59E0B" CornerRadius="6" Padding="10,5" Margin="0,0,12,0">
                                    <TextBlock Text="3" FontWeight="Bold" Foreground="White" FontSize="13"/>
                                </Border>
                                <TextBlock Text="Danh sách Tổ thi đua các cơ quan/đơn vị" FontWeight="SemiBold" Foreground="#1F2937" FontSize="14" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="300"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
                                    <DataGrid x:Name="dgEmulationTeams" Height="180" AutoGenerateColumns="False" CanUserAddRows="False" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F3F4F6" SelectionMode="Single" IsReadOnly="True" RowHeight="40" AlternationCount="2" BorderThickness="0" ItemsSource="{Binding EmulationTeams}" SelectedItem="{Binding SelectedEmulationTeam, Mode=TwoWay}" SelectionChanged="DgEmulationTeams_SelectionChanged">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="STT" Width="50" Binding="{Binding Stt}"/>
                                            <DataGridTextColumn Header="Tên tổ thi đua" Width="180" Binding="{Binding TeamName}"/>
                                            <DataGridTextColumn Header="Tổ trưởng" Width="140" Binding="{Binding Leader}"/>
                                            <DataGridTextColumn Header="Đơn vị thành viên" Width="*" Binding="{Binding Members}"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Border>
                                <Border Grid.Column="2" Background="#F9FAFB" CornerRadius="10" Padding="16">
                                    <StackPanel>
                                        <TextBlock Text="Nhập liệu tổ thi đua" FontWeight="SemiBold" Foreground="#1F2937" FontSize="13" Margin="0,0,0,12"/>
                                        <TextBlock Text="Tên tổ thi đua" Style="{StaticResource FormLabelStyle}"/>
                                        <TextBox x:Name="txtTeamName"/>
                                        <TextBlock Text="Tổ trưởng" Style="{StaticResource FormLabelStyle}" Margin="0,12,0,6"/>
                                        <TextBox x:Name="txtTeamLeader"/>
                                        <TextBlock Text="Đơn vị thành viên" Style="{StaticResource FormLabelStyle}" Margin="0,12,0,6"/>
                                        <TextBox x:Name="txtTeamMembers" Height="60" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                            <Button Content="+ Thêm" Style="{StaticResource BtnPrimary}" Click="BtnAddEmulationTeam_Click"/>
                                            <Button Content="✎ Sửa" Style="{StaticResource BtnGray}" Click="BtnEditEmulationTeam_Click"/>
                                            <Button Content="🗑 Xóa" Style="{StaticResource BtnDanger}" Click="BtnDeleteEmulationTeam_Click"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="↻ Tải lại" Style="{StaticResource BtnGray}" Click="BtnRefresh_Click"/>
                <Button Content="💾 Lưu cấu hình" Style="{StaticResource BtnPrimary}" Click="BtnSave_Click"/>
                <Button Content="Đóng" Style="{StaticResource BtnGray}" Margin="0" Click="BtnClose_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
